{
  "name": "ipeun-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../.ipeun-dev-state",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ipeun --local --persist-to ../.ipeun-dev-state --file=db/schema.sql",
    "db:init:remote": "wrangler d1 execute ipeun --remote --file=db/schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  }
}
